{
  "name": "pergunte-a-reforma",
  "private": true,
  "version": "0.0.0",
  "description": "Agente de IA que calcula CBS/IBS/IS com o motor oficial da Receita Federal e cita a LC 214/2025.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "eval": "pnpm --filter @reforma/eval oficiais",
    "format": "prettier --write \"**/*.{ts,json,yaml,md}\"",
    "format:check": "prettier --check \"packages/**/*.ts\" \"apps/**/*.{ts,tsx}\" \"eval/src/*.ts\" \"scripts/*.mjs\"",
    "local": "node scripts/local.mjs",
    "local:simulado": "node scripts/local.mjs --simulado"
  },
  "license": "MIT",
  "devDependencies": {
    "prettier": "^3.10.1"
  },
  "dependencies": {
    "server-only": "^0.0.1"
  }
}
